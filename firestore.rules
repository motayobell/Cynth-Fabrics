rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "motayobell@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Super Admin', 'Admin', 'Editor'])
      );
    }

    // Products
    match /products/{productId} {
      allow read: if true; // Public can read products
      allow write: if isAdmin(); // Only admins can manage products
    }

    // Content
    match /content/{contentId} {
      allow read: if true; // Public can read content
      allow write: if isAdmin(); // Only admins can manage content
    }

    // Orders
    match /orders/{orderId} {
      allow create: if true; // Public can create orders
      allow read, update, delete: if isAdmin(); // Only admins can view/manage orders
    }

    // Users
    match /users/{userId} {
      // Allow users to read their own profile, or admins to read any profile
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      // Allow the initial admin to create their own profile
      // Or allow an existing admin to create new users
      allow create: if isAuthenticated() && (
        (request.auth.uid == userId && request.auth.token.email == "motayobell@gmail.com") ||
        isAdmin()
      );
      
      // Only admins can update or delete users
      allow update, delete: if isAdmin();
    }

    // Settings
    match /settings/{document=**} {
      allow read: if true; // Public can read settings (like categories)
      allow write: if isAdmin(); // Only admins can manage settings
    }
  }
}
